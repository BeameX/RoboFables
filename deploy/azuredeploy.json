{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Optional. Host the RoboFables static site on App Service from a public zip URL. Replace the zip and restart the app to publish the next build."
  },
  "parameters": {
    "siteName": {
      "type": "string",
      "metadata": { "description": "Name of the App Service. Becomes the hostname." }
    },
    "location": {
      "type": "string",
      "defaultValue": "westeurope",
      "metadata": { "description": "Azure region." }
    },
    "packageUrl": {
      "type": "string",
      "defaultValue": "https://github.com/BeameX/RoboFables/releases/download/web/site.zip",
      "metadata": { "description": "Public URL of the website zip. The zip root must contain index.html." }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2022-09-01",
      "name": "[concat(parameters('siteName'), '-plan')]",
      "location": "[parameters('location')]",
      "sku": { "name": "F1", "tier": "Free" },
      "properties": { "reserved": false }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2022-09-01",
      "name": "[parameters('siteName')]",
      "location": "[parameters('location')]",
      "dependsOn": ["[resourceId('Microsoft.Web/serverfarms', concat(parameters('siteName'), '-plan'))]"],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', concat(parameters('siteName'), '-plan'))]",
        "httpsOnly": true,
        "siteConfig": {
          "appSettings": [
            { "name": "WEBSITE_RUN_FROM_PACKAGE", "value": "[parameters('packageUrl')]" }
          ]
        }
      }
    }
  ],
  "outputs": {
    "url": {
      "type": "string",
      "value": "[concat('https://', parameters('siteName'), '.azurewebsites.net')]"
    }
  }
}
