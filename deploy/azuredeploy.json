{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Optional. Host RoboFables from a public zip. Choose latest, beta, or a numbered build."
  },
  "parameters": {
    "siteName": {
      "type": "string",
      "metadata": { "description": "Name of the App Service." }
    },
    "location": {
      "type": "string",
      "defaultValue": "westeurope",
      "metadata": { "description": "Azure region." }
    },
    "channel": {
      "type": "string",
      "defaultValue": "latest",
      "allowedValues": ["latest", "beta", "build"],
      "metadata": { "description": "latest, beta, or a specific build number." }
    },
    "buildNumber": {
      "type": "string",
      "defaultValue": "1",
      "metadata": { "description": "Used only when channel is build. Example: 1 for web-1." }
    }
  },
  "variables": {
    "packageTag": "[if(equals(parameters('channel'), 'build'), concat('web-', parameters('buildNumber')), concat('web-', parameters('channel')))]",
    "packageUrl": "[concat('https://github.com/BeameX/RoboFables/releases/download/', variables('packageTag'), '/site.zip')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2022-09-01",
      "name": "[concat(parameters('siteName'), '-plan')]",
      "location": "[parameters('location')]",
      "sku": { "name": "F1", "tier": "Free" },
      "properties": { "reserved": false }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2022-09-01",
      "name": "[parameters('siteName')]",
      "location": "[parameters('location')]",
      "dependsOn": ["[resourceId('Microsoft.Web/serverfarms', concat(parameters('siteName'), '-plan'))]"],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', concat(parameters('siteName'), '-plan'))]",
        "httpsOnly": true,
        "siteConfig": {
          "appSettings": [
            { "name": "WEBSITE_RUN_FROM_PACKAGE", "value": "[variables('packageUrl')]" },
            { "name": "ROBOFABLES_CHANNEL", "value": "[parameters('channel')]" },
            { "name": "ROBOFABLES_BUILD", "value": "[parameters('buildNumber')]" }
          ]
        }
      }
    }
  ],
  "outputs": {
    "url": {
      "type": "string",
      "value": "[concat('https://', parameters('siteName'), '.azurewebsites.net')]"
    },
    "packageUrl": {
      "type": "string",
      "value": "[variables('packageUrl')]"
    }
  }
}
